@app.get("/api/admin/stats")
async def admin_stats(
    telegram_user: dict = Depends(current_user),
    session: AsyncSession = Depends(get_session),
):
    if telegram_user["id"] not in settings.admins:
        raise HTTPException(403, "Admin access required")

    users = await session.scalar(select(func.count(User.id)))
    listings = await session.scalar(select(func.count(Listing.id)))
    orders = await session.scalar(select(func.count(Order.id)))
    pending = await session.scalar(
        select(func.count(Listing.id)).where(
            Listing.status == ListingStatus.PENDING
        )
    )

    return {
        "users": users or 0,
        "listings": listings or 0,
        "orders": orders or 0,
        "pending_listings": pending or 0,
    }


