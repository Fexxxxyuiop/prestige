            {
                **listing_to_dict(item),
                "status": item.status.value,
                "owner_telegram_id": item.owner_telegram_id,
            }
            for item in result.scalars().all()
        ]
    }


@app.post("/api/admin/listings/{listing_id}/approve")
async def approve_listing(
    listing_id: int,
    telegram_user: dict = Depends(current_user),
    session: AsyncSession = Depends(get_session),
):
    admin_id = telegram_user["id"]

    if admin_id not in settings.admins:
        raise HTTPException(403, "Admin access required")

    result = await session.execute(
        select(Listing).where(Listing.id == listing_id)
    )
    item = result.scalar_one_or_none()

    if not item:
        raise HTTPException(404, "Listing not found")

    item.status = ListingStatus.APPROVED

    session.add(
        AdminAudit(
            admin_telegram_id=admin_id,
            action="approve_listing",
            target_type="listing",
            target_id=str(listing_id),
        )
    )

    await session.commit()

    return {"ok": True, "status": item.status.value}


@app.post("/api/admin/listings/{listing_id}/reject")
async def reject_listing(
    listing_id: int,
    telegram_user: dict = Depends(current_user),
    session: AsyncSession = Depends(get_session),
):
    admin_id = telegram_user["id"]

    if admin_id not in settings.admins:
        raise HTTPException(403, "Admin access required")

    result = await session.execute(
        select(Listing).where(Listing.id == listing_id)
    )
    item = result.scalar_one_or_none()

    if not item:
        raise HTTPException(404, "Listing not found")

    item.status = ListingStatus.REJECTED

    session.add(
        AdminAudit(
            admin_telegram_id=admin_id,
            action="reject_listing",
            target_type="listing",
            target_id=str(listing_id),
        )
    )

    await session.commit()

    return {"ok": True, "status": item.status.value}
