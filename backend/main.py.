    version="1.0.0",
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=[settings.WEBAPP_URL] if settings.WEBAPP_URL else [],
    allow_credentials=False,
    allow_methods=["GET", "POST"],
    allow_headers=["Content-Type", "X-Telegram-Init-Data"],
)


@app.on_event("startup")
async def startup():
    async with engine.begin() as connection:
        await connection.run_sync(Base.metadata.create_all)


class ListingCreate(BaseModel):
    category: str = Field(min_length=2, max_length=50)
    title: str = Field(min_length=2, max_length=200)
    description: str = Field(default="", max_length=3000)
    image_url: str | None = None
    external_url: str | None = None
    price_per_day: Decimal = Field(gt=0, max_digits=12, decimal_places=2)
    min_days: int = Field(default=1, ge=1, le=365)
    max_days: int = Field(default=30, ge=1, le=365)

    @field_validator("image_url", "external_url")
    @classmethod
    def check_urls(cls, value):
        if value is None or value == "":
            return value

        parsed = urlparse(value)

        if parsed.scheme != "https" or not parsed.hostname:
            raise ValueError("Разрешены только HTTPS-ссылки")

        return value

class RentalCreate(BaseModel):
    listing_id: int
    days: int = Field(ge=1, le=365)


class DigitalOrderCreate(BaseModel):
    kind: str
    quantity: int = Field(default=1, ge=1, le=100)
    description: str = Field(default="", max_length=1000)


class SupportCreate(BaseModel):
    subject: str = Field(min_length=2, max_length=200)
    message: str = Field(min_length=5, max_length=3000)


def listing_to_dict(item: Listing):
    return {
        "id": item.id,
        "category": item.category,
        "title": item.title,
        "description": item.description,
        "image_url": item.image_url,
        "external_url": item.external_url,
        "price_per_day": float(item.price_per_day),
        "min_days": item.min_days,
        "max_days": item.max_days,
        "available": item.available,
    }


def order_to_dict(item: Order):
    return {
        "id": item.public_id,
        "kind": item.kind,
        "listing_id": item.listing_id,
        "quantity": item.quantity,
        "days": item.days,
        "amount": float(item.amount),
        "currency": item.currency,
        "status": item.status.value,
        "description": item.description,
        "created_at": item.created_at.isoformat(),
    }


async def get_or_create_user(
    session: AsyncSession,
    telegram_user: dict,
):
    telegram_id = telegram_user["id"]

    result = await session.execute(
        select(User).where(User.telegram_id == telegram_id)
    )
    user = result.scalar_one_or_none()

    if user is None:
        user = User(
            telegram_id=telegram_id,
            username=telegram_user.get("username"),
            first_name=telegram_user.get("first_name"),
        )
        session.add(user)
        await session.flush()

    return user


