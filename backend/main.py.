@app.get("/api/me")
async def profile(
    telegram_user: dict = Depends(current_user),
    session: AsyncSession = Depends(get_session),
):
    user = await get_or_create_user(session, telegram_user)

    result = await session.execute(
        select(func.count(Order.id)).where(
            Order.telegram_id == user.telegram_id
        )
    )

    await session.commit()

    return {
        "telegram_id": user.telegram_id,
        "username": user.username,
        "first_name": user.first_name,
        "orders_count": result.scalar_one(),
        "support": settings.SUPPORT_USERNAME,
    }


@app.get("/api/listings")
async def get_listings(
    category: str | None = None,
    search: str | None = None,
    limit: int = Query(default=20, ge=1, le=50),
    offset: int = Query(default=0, ge=0),
    session: AsyncSession = Depends(get_session),
):
    query = select(Listing).where(
        Listing.status == ListingStatus.APPROVED,
        Listing.available.is_(True),
    )

    if category:
        query = query.where(Listing.category == category)

    if search:
        query = query.where(
            Listing.title.ilike(f"%{search.strip()}%")
        )

    query = query.order_by(Listing.created_at.desc())
    query = query.offset(offset).limit(limit)

    result = await session.execute(query)
    items = result.scalars().all()

    return {
        "items": [listing_to_dict(item) for item in items],
        "limit": limit,
        "offset": offset,
    }


@app.get("/api/listings/{listing_id}")
async def get_listing(
    listing_id: int,
    session: AsyncSession = Depends(get_session),
):
    result = await session.execute(
        select(Listing).where(
            Listing.id == listing_id,
            Listing.status == ListingStatus.APPROVED,
            Listing.available.is_(True),
        )
    )

    item = result.scalar_one_or_none()

    if not item:
        raise HTTPException(404, "Listing not found")

    return listing_to_dict(item)


@app.post("/api/listings")
async def create_listing(
    data: ListingCreate,
    telegram_user: dict = Depends(current_user),
    session: AsyncSession = Depends(get_session),
):
    user = await get_or_create_user(session, telegram_user)

    if data.max_days < data.min_days:
        raise HTTPException(400, "Invalid rental period")

    item = Listing(
        category=data.category,
        title=data.title,
        description=data.description,
        image_url=data.image_url,
        external_url=data.external_url,
        price_per_day=data.price_per_day,
        min_days=data.min_days,
        max_days=data.max_days,
        owner_telegram_id=user.telegram_id,
        status=ListingStatus.PENDING,
    )

    session.add(item)
    await session.commit()
    await session.refresh(item)

    return {
        "ok": True,
        "id": item.id,
        "status": item.status.value,
        "message": "Listing submitted for moderation",
    }


@app.post("/api/rentals")
async def create_rental(
    data: RentalCreate,
    telegram_user: dict = Depends(current_user),
    session: AsyncSession = Depends(get_session),
):
    user = await get_or_create_user(session, telegram_user)

    result = await session.execute(
        select(Listing).where(
            Listing.id == data.listing_id,
            Listing.status == ListingStatus.APPROVED,
            Listing.available.is_(True),
        )
    )

    item = result.scalar_one_or_none()

    if not item:
        raise HTTPException(404, "Listing unavailable")

    if not item.min_days <= data.days <= item.max_days:
        raise HTTPException(400, "Invalid rental duration")

    amount = Decimal(str(item.price_per_day)) * data.days

    order = Order(
        public_id=secrets.token_hex(6).upper(),
        telegram_id=user.telegram_id,
        kind="rental",
        listing_id=item.id,
        quantity=1,
        days=data.days,
        amount=amount,
        currency="XTR",
        status=OrderStatus.PENDING_MANUAL,
        description=f"Rental: {item.title}, {data.days} days",
    )

    session.add(order)
    await session.commit()

    return {
        "ok": True,
        "order": order_to_dict(order),
        "message": "Request created. Await manager confirmation.",
    }


